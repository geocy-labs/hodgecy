// HodgeCY II Gate A candidate Jacobian input.
// This is not a verified frozen radical node ideal.
LIB "modstd.lib";
ring R = 0, (x,y,z,t), dp;
poly F = 28*t^8 + 2*t^7*x + 2*t^7*y + 2*t^7*z - 4*t^6*x^2 - 2*t^6*x*y - 2*t^6*x*z - 4*t^6*y^2 - 2*t^6*y*z - 4*t^6*z^2 - 2*t^5*x^3 - 2*t^5*x^2*y - 2*t^5*x^2*z - 2*t^5*x*y^2 + 10*t^5*x*y*z - 2*t^5*x*z^2 - 2*t^5*y^3 - 2*t^5*y^2*z - 2*t^5*y*z^2 - 2*t^5*z^3 + 11*t^4*x^4 + 2*t^4*x^3*y + 2*t^4*x^3*z + 5*t^4*x^2*y^2 + 2*t^4*x^2*y*z + 5*t^4*x^2*z^2 + 2*t^4*x*y^3 + 2*t^4*x*y^2*z + 2*t^4*x*y*z^2 + 2*t^4*x*z^3 + 21*t^4*y^4 + 2*t^4*y^3*z + 5*t^4*y^2*z^2 + 2*t^4*y*z^3 + 31*t^4*z^4 + 2*t^3*x^3*y^2 + 2*t^3*x^3*z^2 + 2*t^3*x^2*y^3 + 2*t^3*x^2*y^2*z + 2*t^3*x^2*y*z^2 + 2*t^3*x^2*z^3 + 2*t^3*x*y^2*z^2 + 2*t^3*y^3*z^2 + 2*t^3*y^2*z^3 - t^2*x^4*y^2 - t^2*x^4*z^2 - 2*t^2*x^3*y^3 - 2*t^2*x^3*y^2*z - 2*t^2*x^3*y*z^2 - 2*t^2*x^3*z^3 - t^2*x^2*y^4 - 2*t^2*x^2*y^3*z - 5*t^2*x^2*y^2*z^2 - 2*t^2*x^2*y*z^3 - t^2*x^2*z^4 - 2*t^2*x*y^3*z^2 - 2*t^2*x*y^2*z^3 - t^2*y^4*z^2 - 2*t^2*y^3*z^3 - t^2*y^2*z^4 + 2*t*x^5*y*z - 2*t*x^3*y^2*z^2 - 2*t*x^2*y^3*z^2 - 2*t*x^2*y^2*z^3 + 4*t*x*y^5*z + 6*t*x*y*z^5 + x^8 + 4*x^4*y^4 + x^4*y^2*z^2 + 6*x^4*z^4 + 2*x^3*y^3*z^2 + 2*x^3*y^2*z^3 + x^2*y^4*z^2 + 2*x^2*y^3*z^3 + x^2*y^2*z^4 + 4*y^8 + 12*y^4*z^4 + 9*z^8;
ideal J = jacob(F);
ideal sJ = modStd(J);
"dim(cone) ="; dim(sJ);
"degree ="; mult(sJ);
quit;
